# Copy this file to ".env" and fill in your real values. Never commit ".env".

# Discord webhook URL (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated exact Roblox usernames to watch
ROBLOX_USERNAMES=friend_username_1,friend_username_2

# How often to check, in seconds (60 is a reasonable default)
POLL_INTERVAL_SECONDS=60

# true = also alert when a friend is just "Online" (e.g. on the Roblox home page, not in a game)
# false = only alert once they're actually inside a game
NOTIFY_ON_ONLINE_NOT_JUST_INGAME=true
